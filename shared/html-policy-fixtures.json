{
  "policy_version": "1.0.0",
  "max_bytes": 2097152,
  "note": "Shared conformance corpus. Loaded by worker/test/validate.test.ts (vitest) and cli/internal/validate/html_test.go (go test). Both validators MUST agree with every case. expect_ok=true means the document is accepted; expect_error_codes lists codes that MUST be present when expect_ok=false (order-independent, subset-match: the validator may report additional related codes but must include all listed).",
  "cases": [
    {"id": "ok_minimal", "expect_ok": true, "expect_error_codes": [], "expect_warning_codes": [], "html": "<!DOCTYPE html><html><head><title>Hi</title></head><body><h1>Hello</h1></body></html>"},
    {"id": "ok_semantic", "expect_ok": true, "expect_error_codes": [], "html": "<!DOCTYPE html><html><head><title>Doc</title></head><body><header><nav><a href=\"https://example.com\">link</a></nav></header><main><article><p>Text</p></article></main><footer>f</footer></body></html>"},
    {"id": "ok_inline_style_block", "expect_ok": true, "expect_error_codes": [], "html": "<!DOCTYPE html><html><head><title>S</title><style>body{color:red}h1{font-size:2rem}</style></head><body><h1>x</h1></body></html>"},
    {"id": "ok_style_attr", "expect_ok": true, "expect_error_codes": [], "html": "<!DOCTYPE html><html><head><title>S</title></head><body><p style=\"color:blue;font-weight:bold\">x</p></body></html>"},
    {"id": "ok_https_image", "expect_ok": true, "expect_error_codes": [], "expect_warning_codes": ["W_EXTERNAL_IMAGES"], "html": "<!DOCTYPE html><html><head><title>I</title></head><body><img src=\"https://example.com/a.png\" alt=\"a\"></body></html>"},
    {"id": "ok_data_image", "expect_ok": true, "expect_error_codes": [], "html": "<!DOCTYPE html><html><head><title>I</title></head><body><img src=\"data:image/png;base64,iVBORw0KGgo=\" alt=\"a\"></body></html>"},
    {"id": "ok_inline_svg", "expect_ok": true, "expect_error_codes": [], "html": "<!DOCTYPE html><html><head><title>V</title></head><body><svg viewBox=\"0 0 10 10\"><circle cx=\"5\" cy=\"5\" r=\"4\"/></svg></body></html>"},
    {"id": "ok_mailto_and_fragment", "expect_ok": true, "expect_error_codes": [], "html": "<!DOCTYPE html><html><head><title>L</title></head><body><a href=\"mailto:a@b.com\">m</a><a href=\"#sec\">s</a></body></html>"},
    {"id": "ok_table", "expect_ok": true, "expect_error_codes": [], "html": "<!DOCTYPE html><html><head><title>T</title></head><body><table><thead><tr><th>a</th></tr></thead><tbody><tr><td>1</td></tr></tbody></table></body></html>"},
    {"id": "ok_video_https", "expect_ok": true, "expect_error_codes": [], "html": "<!DOCTYPE html><html><head><title>Vid</title></head><body><video controls><source src=\"https://example.com/v.mp4\" type=\"video/mp4\"></video></body></html>"},
    {"id": "ok_meta_viewport", "expect_ok": true, "expect_error_codes": [], "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width\"><title>M</title></head><body>x</body></html>"},
    {"id": "ok_comment", "expect_ok": true, "expect_error_codes": [], "html": "<!DOCTYPE html><html><head><title>C</title></head><body><!-- a normal comment --><p>x</p></body></html>"},
    {"id": "ok_fragment_no_doctype", "expect_ok": true, "expect_error_codes": [], "expect_warning_codes": ["W_NO_DOCTYPE"], "html": "<html><head><title>F</title></head><body><p>fragment</p></body></html>"},
    {"id": "ok_no_title", "expect_ok": true, "expect_error_codes": [], "expect_warning_codes": ["W_NO_TITLE"], "html": "<!DOCTYPE html><html><head></head><body><p>no title here</p></body></html>"},

    {"id": "block_script_inline", "expect_ok": false, "expect_error_codes": ["E_SCRIPT"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><script>alert(1)</script></body></html>"},
    {"id": "block_script_src", "expect_ok": false, "expect_error_codes": ["E_SCRIPT"], "html": "<!DOCTYPE html><html><head><title>x</title><script src=\"https://evil.example/x.js\"></script></head><body>x</body></html>"},
    {"id": "block_script_module", "expect_ok": false, "expect_error_codes": ["E_SCRIPT"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><script type=\"module\">import('x')</script></body></html>"},
    {"id": "block_script_uppercase", "expect_ok": false, "expect_error_codes": ["E_SCRIPT"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><SCRIPT>alert(1)</SCRIPT></body></html>"},
    {"id": "block_script_in_style_close", "expect_ok": false, "expect_error_codes": ["E_SCRIPT"], "html": "<!DOCTYPE html><html><head><title>x</title><style></style><script>x</script></head><body>y</body></html>"},
    {"id": "block_iframe", "expect_ok": false, "expect_error_codes": ["E_FRAME"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><iframe src=\"https://evil.example\"></iframe></body></html>"},
    {"id": "block_object", "expect_ok": false, "expect_error_codes": ["E_PLUGIN"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><object data=\"x.swf\"></object></body></html>"},
    {"id": "block_embed", "expect_ok": false, "expect_error_codes": ["E_PLUGIN"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><embed src=\"x.swf\"></body></html>"},
    {"id": "block_applet", "expect_ok": false, "expect_error_codes": ["E_PLUGIN"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><applet code=\"x\"></applet></body></html>"},
    {"id": "block_form", "expect_ok": false, "expect_error_codes": ["E_FORM"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><form action=\"https://evil.example\"><input name=\"pw\"></form></body></html>"},
    {"id": "block_input_standalone", "expect_ok": false, "expect_error_codes": ["E_FORM"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><input type=\"password\"></body></html>"},
    {"id": "block_textarea", "expect_ok": false, "expect_error_codes": ["E_FORM"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><textarea>x</textarea></body></html>"},
    {"id": "block_base", "expect_ok": false, "expect_error_codes": ["E_BASE"], "html": "<!DOCTYPE html><html><head><title>x</title><base href=\"https://evil.example/\"></head><body>x</body></html>"},
    {"id": "block_link", "expect_ok": false, "expect_error_codes": ["E_LINK"], "html": "<!DOCTYPE html><html><head><title>x</title><link rel=\"stylesheet\" href=\"https://evil.example/x.css\"></head><body>x</body></html>"},
    {"id": "block_meta_refresh", "expect_ok": false, "expect_error_codes": ["E_META_REFRESH"], "html": "<!DOCTYPE html><html><head><title>x</title><meta http-equiv=\"refresh\" content=\"0;url=https://evil.example\"></head><body>x</body></html>"},
    {"id": "block_onclick", "expect_ok": false, "expect_error_codes": ["E_EVENT_HANDLER"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><div onclick=\"alert(1)\">x</div></body></html>"},
    {"id": "block_onload_body", "expect_ok": false, "expect_error_codes": ["E_EVENT_HANDLER"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body onload=\"alert(1)\">x</body></html>"},
    {"id": "block_onerror_img", "expect_ok": false, "expect_error_codes": ["E_EVENT_HANDLER"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><img src=\"x\" onerror=\"alert(1)\"></body></html>"},
    {"id": "block_onmouseover_upper", "expect_ok": false, "expect_error_codes": ["E_EVENT_HANDLER"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><a href=\"https://e.com\" OnMouseOver=\"x\">y</a></body></html>"},
    {"id": "block_href_javascript", "expect_ok": false, "expect_error_codes": ["E_DANGEROUS_URL"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><a href=\"javascript:alert(1)\">x</a></body></html>"},
    {"id": "block_href_javascript_entity", "expect_ok": false, "expect_error_codes": ["E_DANGEROUS_URL"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><a href=\"java&#x09;script:alert(1)\">x</a></body></html>"},
    {"id": "block_href_javascript_mixedcase_ws", "expect_ok": false, "expect_error_codes": ["E_DANGEROUS_URL"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><a href=\" JaVaScRiPt:alert(1)\">x</a></body></html>"},
    {"id": "block_href_javascript_newline", "expect_ok": false, "expect_error_codes": ["E_DANGEROUS_URL"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><a href=\"java\nscript:alert(1)\">x</a></body></html>"},
    {"id": "block_vbscript", "expect_ok": false, "expect_error_codes": ["E_DANGEROUS_URL"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><a href=\"vbscript:msgbox(1)\">x</a></body></html>"},
    {"id": "block_data_texthtml", "expect_ok": false, "expect_error_codes": ["E_DANGEROUS_URL"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><a href=\"data:text/html,<script>alert(1)</script>\">x</a></body></html>"},
    {"id": "block_file_url", "expect_ok": false, "expect_error_codes": ["E_DANGEROUS_URL"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><a href=\"file:///etc/passwd\">x</a></body></html>"},
    {"id": "block_img_javascript_src", "expect_ok": false, "expect_error_codes": ["E_DANGEROUS_URL"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><img src=\"javascript:alert(1)\"></body></html>"},
    {"id": "block_srcdoc", "expect_ok": false, "expect_error_codes": ["E_SRCDOC", "E_FRAME"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><iframe srcdoc=\"<script>alert(1)</script>\"></iframe></body></html>"},
    {"id": "block_css_expression", "expect_ok": false, "expect_error_codes": ["E_DANGEROUS_CSS"], "html": "<!DOCTYPE html><html><head><title>x</title><style>div{width:expression(alert(1))}</style></head><body>x</body></html>"},
    {"id": "block_css_behavior", "expect_ok": false, "expect_error_codes": ["E_DANGEROUS_CSS"], "html": "<!DOCTYPE html><html><head><title>x</title><style>div{behavior:url(x.htc)}</style></head><body>x</body></html>"},
    {"id": "block_css_url_javascript", "expect_ok": false, "expect_error_codes": ["E_DANGEROUS_CSS"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><div style=\"background:url(javascript:alert(1))\">x</div></body></html>"},
    {"id": "block_css_import", "expect_ok": false, "expect_error_codes": ["E_DANGEROUS_CSS"], "html": "<!DOCTYPE html><html><head><title>x</title><style>@import url('https://evil.example/x.css');</style></head><body>x</body></html>"},
    {"id": "block_svg_script", "expect_ok": false, "expect_error_codes": ["E_MXSS", "E_SCRIPT"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><svg><script>alert(1)</script></svg></body></html>"},
    {"id": "block_math_annotation_xml", "expect_ok": false, "expect_error_codes": ["E_MXSS"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><math><annotation-xml encoding=\"text/html\"><span>x</span></annotation-xml></math></body></html>"},
    {"id": "block_svg_onload", "expect_ok": false, "expect_error_codes": ["E_EVENT_HANDLER"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><svg onload=\"alert(1)\"><circle r=\"1\"/></svg></body></html>"},
    {"id": "block_svg_a_xlink_javascript", "expect_ok": false, "expect_error_codes": ["E_DANGEROUS_URL"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><svg><a xlink:href=\"javascript:alert(1)\"><text>x</text></a></svg></body></html>"},
    {"id": "block_noscript_script", "expect_ok": false, "expect_error_codes": ["E_SCRIPT"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><noscript><script>alert(1)</script></noscript></body></html>"},
    {"id": "block_template_script", "expect_ok": false, "expect_error_codes": ["E_SCRIPT"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><template><script>alert(1)</script></template></body></html>"},
    {"id": "block_formaction", "expect_ok": false, "expect_error_codes": ["E_FORM"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><form><button formaction=\"javascript:alert(1)\">x</button></form></body></html>"},
    {"id": "block_ping", "expect_ok": false, "expect_error_codes": ["E_ATTR_UNSAFE"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><a href=\"https://e.com\" ping=\"https://evil.example/track\">x</a></body></html>"},
    {"id": "block_meta_http_equiv_csp", "expect_ok": false, "expect_error_codes": ["E_ATTR_UNSAFE"], "html": "<!DOCTYPE html><html><head><title>x</title><meta http-equiv=\"set-cookie\" content=\"a=b\"></head><body>x</body></html>"},
    {"id": "block_unterminated_comment", "expect_ok": false, "expect_error_codes": ["E_MALFORMED"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><!-- <script>alert(1)</script> <p>never closed</body></html>"},
    {"id": "block_cdata_outside_foreign", "expect_ok": false, "expect_error_codes": ["E_MALFORMED"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><![CDATA[<script>alert(1)</script>]]></body></html>"},
    {"id": "block_frameset", "expect_ok": false, "expect_error_codes": ["E_FRAME"], "html": "<!DOCTYPE html><html><head><title>x</title></head><frameset><frame src=\"https://evil.example\"></frameset></html>"},
    {"id": "block_empty", "expect_ok": false, "expect_error_codes": ["E_EMPTY"], "html": "   \n  \t "},
    {"id": "block_portal", "expect_ok": false, "expect_error_codes": ["E_FRAME"], "html": "<!DOCTYPE html><html><head><title>x</title></head><body><portal src=\"https://evil.example\"></portal></body></html>"}
  ]
}
