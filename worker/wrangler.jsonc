{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentdraft-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "production",
    // Public base URL of the CONTENT worker (separate origin). Overwritten after the
    // content worker is first deployed and its workers.dev URL is known.
    "CONTENT_BASE_URL": "https://agentdraft.tapetide.com",
    "DASHBOARD_ORIGIN": "https://app.agentdraft.tapetide.com",
    "GOOGLE_OAUTH_ENABLED": "true",
    // "hosted"      -> Google sign-in is the ONLY way in; API keys can be minted
    //                  exclusively from the dashboard by a Google-verified session.
    // "self-hosted" -> API-key paste is also accepted (a self-hoster may have no IdP).
    "AUTH_MODE": "hosted"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentdraft-db",
      "database_id": "16789f34-d974-4a5f-85c6-457599145fea",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "agentdraft-html"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATELIMIT",
      "id": "96fb4011d5474288a280e9a26135c512"
    }
  ],
  "placement": { "mode": "smart" },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
