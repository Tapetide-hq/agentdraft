{
  "name": "webhost-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && cp .assetsignore .svelte-kit/cloudflare/.assetsignore",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "4.8.0",
    "@sveltejs/kit": "2.12.1",
    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "svelte": "5.15.0",
    "svelte-check": "4.1.1",
    "typescript": "5.7.2",
    "vite": "6.0.5",
    "wrangler": "4.97.0"
  }
}
